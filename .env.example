# Telegram
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN
BOT_USERNAME=YOUR_BOT_USERNAME
WEBAPP_URL=https://your-domain.example/
ADMIN_IDS=PASTE_TELEGRAM_ADMIN_ID
# Optional proxy ONLY for this Python bot's Telegram Bot API requests.
# Examples with a separately running proxy: http://127.0.0.1:7890 or socks5://127.0.0.1:1080
# WARP itself does not normally expose a local HTTP/SOCKS proxy endpoint.
BOT_PROXY=
BOT_API_TIMEOUT=12

# MySQL / Percona (replace with your hosting values)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=YOUR_DATABASE_NAME
MYSQL_USER=YOUR_DATABASE_USER
MYSQL_PASSWORD=YOUR_DATABASE_PASSWORD
# One bot instance: start with 5; lower it if your hosting has a strict MySQL connection limit.
MYSQL_POOL_SIZE=5
MYSQL_POOL_MINSIZE=1

# Local storage and concurrent import limits
DATA_DIR=./bot/data
MAX_FILE_SIZE_MB=20
MAX_CONCURRENT_FILES=3
LOG_LEVEL=INFO

# Optional stable secret for encrypting full activation keys in the admin panel.
# Keep this value unchanged after enabling it, otherwise previously encrypted keys cannot be revealed.
# Generate once with: openssl rand -hex 32. Store the same value in PHP config/env. Never change it later.
KEY_ENCRYPTION_SECRET=replace_with_a_private_random_secret

# Optional source connection for migrate_database.py / admin-cli.py migrate-db.
# If empty, the tool prompts for the source DB or can load it from config/database.php.
# The destination defaults to NEW_MYSQL_*, TARGET_MYSQL_*, or the regular MYSQL_* above.
# OLD_MYSQL_HOST=old-db.example.com
# OLD_MYSQL_PORT=3306
# OLD_MYSQL_USER=old_db_user
# OLD_MYSQL_PASSWORD=change_me
# OLD_MYSQL_DATABASE=old_database
# Optional destination overrides (if the destination is not the regular MYSQL_* DB):
# NEW_MYSQL_HOST=new-db.example.com
# NEW_MYSQL_PORT=3306
# NEW_MYSQL_USER=new_db_user
# NEW_MYSQL_PASSWORD=change_me
# NEW_MYSQL_DATABASE=new_database
