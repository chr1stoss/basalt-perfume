Options -Indexes
<FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
  Order deny,allow
  Deny from all
</FilesMatch>

# Telegram avatar cache files are content/user-keyed; hash names change when the source image changes.
<IfModule mod_headers.c>
  <FilesMatch "^[a-f0-9]{64}\.(?:jpg|jpeg|png|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "^[a-f0-9]{64}\.(?:jpg|jpeg|png|webp|svg)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^[a-f0-9]{64}\.svg$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
</IfModule>
